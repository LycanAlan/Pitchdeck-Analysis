# Keep the build context to source only. Everything below is either huge,
# secret, host-specific, or reconstructed inside the image.

.git/
.gitignore
.venv/
venv/
env/

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
pyrefly.toml

.env
.env.*
!.env.example

# Source PDFs are 67MB and the FAISS index is rebuilt inside the container.
# data/documents (the ingested corpus) and data/eval are NOT excluded: the image
# copies them so a deployed container has something to answer from.
data/decks/
data/indices/
results/
*.pdf

# Superseded by the pitchlens package.
preprocessing/
rag_pipeline/

.ipynb_checkpoints/
*.ipynb
.DS_Store
.vscode/
.idea/
.claude/

Dockerfile
.dockerignore
docker-compose.yml
README.md
*.md
